# Vector Experimentation - Environment Configuration Example
# Copy this file to .env and update with your values

# ===== GATEWAY CONFIGURATION =====
VECTOR_GATEWAY_HOST=localhost
VECTOR_GATEWAY_PORT=9000
VECTOR_GATEWAY_ADDRESS=0.0.0.0

# ===== TLS/SSL CONFIGURATION =====
TLS_CERT_DIR=./certs
TLS_CA_FILE=${TLS_CERT_DIR}/ca.crt
TLS_GATEWAY_CERT_FILE=${TLS_CERT_DIR}/gateway.crt
TLS_GATEWAY_KEY_FILE=${TLS_CERT_DIR}/gateway.key
TLS_VERIFY_CERTIFICATE=true
TLS_VERIFY_HOSTNAME=true

# ===== DATA DIRECTORIES =====
VECTOR_AGENT_DATA_DIR=./data/agent
VECTOR_GATEWAY_DATA_DIR=./data/gateway

# ===== LOG SOURCE CONFIGURATION =====
# Generic log file path (for generic adapter_logs source)
LOG_FILE_PATH=./data/examples/*.log
LOG_READ_FROM=beginning

# Contextual adapter-specific log paths
SSB_LOG_FILE_PATH=./data/logs/ssb_adapter*.log
SSB_LOG_READ_FROM=beginning

# Add more adapter-specific configs as needed:
# CBS_LOG_FILE_PATH=./data/logs/cbs_adapter*.log
# CBS_LOG_READ_FROM=beginning
# RTGS_LO
# ===== HTTP SINK CONFIGURATION =====
HTTP_COMPRESSION=gzip
HTTP_REQUEST_TIMEOUT_SECS=60
HTTP_REQUEST_RETRY_ATTEMPTS=5
HTTP_REQUEST_RETRY_INITIAL_BACKOFF_SECS=1
HTTP_REQUEST_RETRY_MAX_DURATION_SECS=30
HTTP_BATCH_TIMEOUT_SECS=1
HTTP_BATCH_MAX_BYTES=10000000
HTTP_BATCH_MAX_EVENTS=1000

# ===== HEALTH CHECK =====
HEALTHCHECK_ENABLED=true

# ===== ACKNOWLEDGEMENTS =====
ACKNOWLEDGEMENTS_ENABLED=true

# ===== ENVIRONMENT =====
ENVIRONMENT=development
